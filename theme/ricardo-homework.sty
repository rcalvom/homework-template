\NewDocumentCommand{\homeworktheorembegin}{m m m}{%
  \refstepcounter{#1}%
  \Needspace{9\baselineskip}%
  \subsection*{#2~\csuse{the#1}\ifstrempty{#3}{}{\space(#3)}}%
  % The same rail-and-tint idiom as the callouts, so a page carrying a
  % theorem and a solution does not show two different kinds of box meaning
  % roughly the same thing. The heading above it already says which it is,
  % so the box itself needs no label -- only to be visibly set apart.
  \begin{tcolorbox}[
    enhanced,
    breakable,
    sharp corners,
    frame hidden,
    boxrule=0pt,
    colback=rzaccentsoft,
    borderline west={2.2pt}{0pt}{rzaccent},
    left=8pt,
    right=8pt,
    top=6pt,
    bottom=6pt,
    before skip=0.9\baselineskip,
    after skip=0.9\baselineskip
  ]%
}
\NewDocumentCommand{\homeworktheoremend}{}{\end{tcolorbox}}

\NewDocumentEnvironment{theorem}{O{}}{\homeworktheorembegin{theorem}{Theorem}{#1}}{\homeworktheoremend}
\NewDocumentEnvironment{lemma}{O{}}{\homeworktheorembegin{lemma}{Lemma}{#1}}{\homeworktheoremend}
\NewDocumentEnvironment{proposition}{O{}}{\homeworktheorembegin{proposition}{Proposition}{#1}}{\homeworktheoremend}
\NewDocumentEnvironment{corollary}{O{}}{\homeworktheorembegin{corollary}{Corollary}{#1}}{\homeworktheoremend}
\NewDocumentEnvironment{definition}{O{}}{\homeworktheorembegin{definition}{Definition}{#1}}{\homeworktheoremend}
\NewDocumentEnvironment{remark}{O{}}{\homeworktheorembegin{remark}{Remark}{#1}}{\homeworktheoremend}
\csundef{proof}
\csundef{endproof}
\NewDocumentEnvironment{proof}{O{Proof}}{%
  \par\smallskip\noindent\textit{#1.}\space
}{%
  \hfill$\square$\par\smallskip
}

% Headings carry the accent. It is the one colour in the document that says
% `structure' rather than `state', and putting it on the headings is what ties
% them to the callout labels and the code plate's tab.
\sectionfont{\color{rzaccent}\normalfont\Large\bfseries}
\subsectionfont{\color{rzaccent}\normalfont\large\bfseries}

\fancypagestyle{homeworkfirst}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\small\color{rzmuted}\thepage}
}
% Course on the left, assignment on the right, with a hairline under them.
% The title block on page one is centred; this is not, and that is the point:
% a running head is a locator, and two anchors at the outer edges are easier
% to find with a thumb than one line in the middle.
\fancypagestyle{homework}{%
  \fancyhf{}
  \fancyhead[L]{\small\CourseCode}
  \fancyhead[R]{\small\HomeworkTitle}
  \fancyfoot[C]{\small\color{rzmuted}\thepage}
  \renewcommand{\headrulewidth}{0.5pt}
  \renewcommand{\footrulewidth}{0pt}
  % The rule takes the accent; the two labels stay in ink.
  %
  % Page one closes its header with an accent rule, so this is the same mark
  % repeated rather than a second idea -- which is most of what gives a
  % document a signature. Putting the accent on the *text* instead was the
  % other option and is worse: the headings are accent, and a coloured
  % running head would read as loud as a heading on every page while saying
  % something the reader already knows.
  %
  % It is decoration, so WCAG 1.4.11 does not apply -- but #005F87 measures
  % 7.03:1 on white, so the question does not arise either way.
  \renewcommand{\headrule}{{\color{rzaccent}%
    \hrule height \headrulewidth width \headwidth}}
}
\pagestyle{homework}

