% =====================================================================
%  A document is a folder
% =====================================================================
% \DocFolder{fragments/problems} inputs every .tex in that folder, in name
% order. Adding a problem is then creating a file, and nothing else -- no
% \input line to remember, and no list in two places to drift apart.
%
% Number the files with room to grow: 010, 020, 030. Inserting between two is
% 015, and no other file has to move. Counting them 1, 2, 3 instead means
% renumbering the folder every time something goes in the middle.
%
% The listing is done in Lua because TeX cannot read a directory. lfs is built
% into LuaTeX, so this needs no shell escape and no generated file.
\directlua{rzfolder = dofile("theme/ricardo-folder.lua")}
\NewDocumentCommand{\DocFolder}{m}{\directlua{rzfolder.folder("#1")}}

