\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theme/ricardo-typeface}[2026/08/31 Homework typeface]

% The body stays in LaTeX's own serif -- Latin Modern, which is Computer
% Modern's OpenType successor and looks the same. A homework is paragraphs of
% prose, proofs and mathematics, and that face is what those are set in.
%
% Only the typewriter family changes. Code is where this template carries its
% identity, and that identity is UbuntuMono: the same face the author's
% terminal, editor and slides use.
%
% fontspec is what loads a .ttf, and fontspec needs lualatex -- which is why
% the Makefile's engine is lualatex and not pdflatex. Nothing else about the
% body text depends on that switch.
\RequirePackage{fontspec}
\RequirePackage{microtype}

% The font ships inside the repository, as it does in the slides project, so a
% clone and the container render identically. The fallbacks matter less here
% than they do there, but a missing file should still say so rather than
% silently substituting Courier.
\newif\ifrz@nerdglyphs \rz@nerdglyphstrue
\IfFontExistsTF{assets/fonts/UbuntuMonoNerdFont-Regular.ttf}{%
  \setmonofont{UbuntuMonoNerdFont-Regular.ttf}[
    Path            = assets/fonts/,
    BoldFont        = UbuntuMonoNerdFont-Bold.ttf,
    ItalicFont      = UbuntuMonoNerdFont-Italic.ttf,
    BoldItalicFont  = UbuntuMonoNerdFont-BoldItalic.ttf,
    Scale           = MatchLowercase,
  ]%
}{%
  \IfFontExistsTF{UbuntuMono Nerd Font}{%
    \PackageWarning{theme/ricardo-typeface}{assets/fonts/ is missing;
      falling back to the system UbuntuMono Nerd Font}%
    \setmonofont{UbuntuMono Nerd Font}[Scale=MatchLowercase]%
  }{%
    \PackageWarning{theme/ricardo-typeface}{No UbuntuMono Nerd Font found;
      code will be set in the default typewriter face and the icons will be
      missing. Run `make fonts' or install ttf-ubuntu-mono-nerd}%
    \rz@nerdglyphsfalse
  }%
}

% Scale=MatchLowercase and not a fixed number: UbuntuMono's x-height is larger
% than Latin Modern's, so at a nominal match the code looks a size too big
% beside the prose. Matching the lowercase is what makes the two sit together.

% The zsh prompt arrow, for the terminal environment. No UbuntuMono variant
% has U+279C; the terminal only appears to, because fontconfig substitutes
% Adwaita Mono for that one codepoint. This is that font, subset to the single
% glyph, so the template does deliberately what the terminal does by accident.
\IfFontExistsTF{assets/fonts/rz-prompt-arrow.ttf}{%
  \newfontfamily\rzpromptfont{rz-prompt-arrow.ttf}[Path=assets/fonts/]%
  % Lowered by 80/1000 em, which is measured and not taste.
  %
  % Both fonts are 1000 units per em and both have an x-height of 520, so
  % there is no scale mismatch to correct -- the glyph itself is drawn high.
  % Adwaita Mono's U+279C spans yMin 20 to yMax 660, putting its optical
  % centre at 340; UbuntuMono's x-height centre is at 260. The 80 in between
  % is why the arrow read as sitting above the line while the hyphens beside
  % it sat in the middle of it.
  %
  % [0pt][0pt] so the lowered box adds no depth. Without it the arrow would
  % deepen its line and open up the spacing of a transcript, which is a
  % strange price to pay for moving one glyph 0.8pt at body size.
  \newcommand{\rzprompt}{%
    \raisebox{-0.08em}[0pt][0pt]{{\rzpromptfont\symbol{"279C}}}}%
}{%
  \newcommand{\rzprompt}{>}%
}

\normalfont
\frenchspacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55\baselineskip}
\setlength{\emergencystretch}{2em}
